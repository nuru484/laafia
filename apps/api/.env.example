DATABASE_URL=postgresql:///laafia?host=/var/run/postgresql
# Tests run against this database and truncate it.
TEST_DATABASE_URL=postgresql:///laafia_test?host=/var/run/postgresql
PORT=4000
JWT_SECRET=change-me-to-32-plus-random-chars
# Web dashboard and admin endpoints: header x-admin-token (or ?token= for SSE).
ADMIN_TOKEN=change-me
# Optional. When unset, outgoing SMS are logged instead of sent.
ARKESEL_API_KEY=
ARKESEL_SENDER=Laafia
# Optional shared secret for the gateway webhook: POST /sms/inbound?token=...
SMS_WEBHOOK_TOKEN=
