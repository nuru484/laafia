# Copy to apps/api/.env (gitignored). Validated at boot by src/env.ts; the server
# exits with a list of problems if anything is wrong. Empty values count as unset.

# development | test | production. Production requires JWT_SECRET, ADMIN_TOKEN and SMS_WEBHOOK_TOKEN.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql:///laafia?host=/var/run/postgresql
# Tests run against this database and truncate it.
TEST_DATABASE_URL=postgresql:///laafia_test?host=/var/run/postgresql

# HS256 key for device JWTs. At least 32 chars in production (openssl rand -hex 32).
JWT_SECRET=
# Web dashboard and /admin/* endpoints, sent as header x-admin-token. At least 24 chars in production.
ADMIN_TOKEN=
# Shared secret for POST /sms/inbound (header x-webhook-token, or ?token= in the URL configured at Arkesel). At least 24 chars in production.
SMS_WEBHOOK_TOKEN=
# CORS origin of the web dashboard. Unset allows any origin (tokens travel in headers, not cookies).
WEB_ORIGIN=

# Arkesel SMS gateway. When unset, outgoing SMS are only logged (masked number, length).
ARKESEL_API_KEY=
# Sender ID, at most 11 characters, registered with Arkesel.
ARKESEL_SENDER=Laafia

# Khaya (GhanaNLP) speech-to-text for POST /voice/transcribe. Unset returns 503 khaya_unconfigured.
KHAYA_API_KEY=
KHAYA_BASE_URL=https://translation-api.ghananlp.org

# DHIS2 Tracker source for /admin/import/dhis2/preview (one district per deployment).
DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=

# Where content packs (audio zips, PMTiles) are stored on disk.
CONTENT_DIR=./content
