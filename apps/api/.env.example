NODE_ENV=development
PORT=4000

# Postgres connection string
DATABASE_URL=postgresql://<os-user>@localhost/laafia?host=/var/run/postgresql
# Test database (defaults to laafia_api_test)
TEST_DATABASE_URL=postgresql://<os-user>@localhost/laafia_api_test?host=/var/run/postgresql

# Device JWT signing key, 32+ chars
JWT_SECRET=
# Admin and web dashboard token (header x-admin-token), 24+ chars
ADMIN_TOKEN=
# Token for POST /sms/inbound (header x-webhook-token or ?token=), 24+ chars
SMS_WEBHOOK_TOKEN=
# Web dashboard origin for CORS
WEB_ORIGIN=
# Proxies trusted for X-Forwarded-For: addresses, or a hop count (1 on Render)
TRUST_PROXY=loopback

# Frog by Wigal SMS gateway (unset: messages are only logged)
FROG_API_KEY=
FROG_USERNAME=
FROG_SENDER_ID=Laafia
# Token for Frog delivery receipts, POST /sms/delivery (header x-callback-token or ?token=)
SMS_CALLBACK_SECRET=
