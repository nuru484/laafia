{
  "cli": {
    "version": ">= 16.27.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.12.0",
      "env": {
        "EAS_PROJECT_ID": "26f46790-c99e-425f-b8ab-cb6fbf098a52",
        "EXPO_OWNER": "manuru"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "distribution": "internal",
      "channel": "production",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    }
  }
}
