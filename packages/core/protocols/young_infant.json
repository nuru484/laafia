{
  "id": "young_infant",
  "version": 2,
  "clinical_review": "pending: WHO IMNCI 2014 young infant and PSBI 2015; to be reviewed by the team clinician",
  "questions": [
    { "id": "yi_feeding", "type": "yesno", "text_en": "Is the baby feeding well?" },
    { "id": "yi_feeding_problem", "type": "yesno", "text_en": "Is the baby breastfed fewer than 8 times in 24 hours, or is the attachment to the breast poor?", "ask_if": { "yi_feeding": true } },
    { "id": "yi_convulsions", "type": "yesno", "text_en": "Has the baby had fits or convulsions?" },
    { "id": "yi_movement", "type": "yesno", "text_en": "Does the baby move only when touched, or not at all?" },
    { "id": "yi_breaths", "type": "number", "unit": "breaths/min", "text_en": "Count the baby's breaths for one full minute." },
    { "id": "yi_chest_indrawing", "type": "yesno", "text_en": "Does the lower chest pull in strongly when the baby breathes in?" },
    { "id": "yi_temp", "type": "number", "unit": "°C", "text_en": "Take the baby's temperature." },
    { "id": "yi_yellow", "type": "yesno", "text_en": "Is the baby's skin, or the white of the eyes, yellow?" },
    { "id": "yi_jaundice", "type": "yesno", "text_en": "Are the palms or soles yellow?", "ask_if": { "yi_yellow": true } },
    { "id": "yi_cord", "type": "yesno", "text_en": "Is the cord stump red or draining pus?" },
    { "id": "yi_pustules", "type": "yesno", "text_en": "Are there pus spots (pustules) on the skin?" },
    { "id": "yi_pustules_many", "type": "yesno", "text_en": "Are there 10 or more, or a large boil?", "ask_if": { "yi_pustules": true } },
    { "id": "yi_diarrhoea", "type": "yesno", "text_en": "Does the baby have diarrhoea (more watery stools than usual)?" },
    { "id": "yi_dehydration", "type": "yesno", "text_en": "Are the eyes sunken, or does a pinch of belly skin go back slowly?", "ask_if": { "yi_diarrhoea": true } },
    { "id": "yi_eye", "type": "yesno", "text_en": "Is pus coming from the eyes?" }
  ],
  "rules": [
    { "id": "YI-R1", "when": { "yi_feeding": false }, "outcome": "refer", "urgency": 3, "danger_sign": "not_feeding", "actions": ["keep_warm", "breastfeed_on_way", "go_now"], "stop": true },
    { "id": "YI-R2", "when": { "yi_convulsions": true }, "outcome": "refer", "urgency": 3, "danger_sign": "convulsions", "actions": ["keep_warm", "go_now"], "stop": true },
    { "id": "YI-R3", "when": { "yi_movement": true }, "outcome": "refer", "urgency": 3, "danger_sign": "movement", "actions": ["keep_warm", "go_now"] },
    { "id": "YI-R4", "when": { "yi_breaths": { "gte": 60 } }, "outcome": "refer", "urgency": 2, "danger_sign": "fast_breathing", "actions": ["keep_warm", "breastfeed_on_way", "go_today"] },
    { "id": "YI-R5", "when": { "yi_chest_indrawing": true }, "outcome": "refer", "urgency": 3, "danger_sign": "chest_indrawing", "actions": ["keep_warm", "go_now"] },
    { "id": "YI-R6", "when": { "yi_temp": { "gte": 37.5 } }, "outcome": "refer", "urgency": 3, "danger_sign": "fever", "actions": ["breastfeed_on_way", "go_now"] },
    { "id": "YI-R7", "when": { "yi_temp": { "lte": 35.4 } }, "outcome": "refer", "urgency": 3, "danger_sign": "hypothermia", "actions": ["keep_warm", "go_now"] },
    { "id": "YI-R8", "when": { "yi_jaundice": true }, "outcome": "refer", "urgency": 2, "danger_sign": "jaundice", "actions": ["breastfeed_on_way", "go_today"] },
    { "id": "YI-R9", "when": { "all": [{ "yi_yellow": true }, { "age_days": { "lte": 1 } }] }, "outcome": "refer", "urgency": 3, "danger_sign": "early_jaundice", "actions": ["go_now", "breastfeed_on_way", "keep_warm"] },
    { "id": "YI-R10", "when": { "yi_dehydration": true }, "outcome": "refer", "urgency": 3, "danger_sign": "dehydration", "actions": ["go_now", "breastfeed_on_way"] },
    { "id": "YI-R11", "when": { "yi_pustules_many": true }, "outcome": "refer", "urgency": 2, "danger_sign": "many_pustules", "actions": ["go_today", "keep_warm"] },
    { "id": "YI-F1", "when": { "yi_temp": { "gte": 35.5, "lte": 36.4 } }, "outcome": "followup", "followup_days": 1, "actions": ["kangaroo"] },
    { "id": "YI-F2", "when": { "yi_cord": true }, "outcome": "followup", "followup_days": 2, "actions": ["cord_care"] },
    { "id": "YI-F3", "when": { "birth_weight_g": { "lte": 2499 }, "age_days": { "lte": 7 } }, "outcome": "followup", "followup_days": 1, "actions": ["kangaroo", "counsel_feeding"] },
    { "id": "YI-F4", "when": { "yi_yellow": true }, "outcome": "followup", "followup_days": 1, "actions": ["jaundice_watch"] },
    { "id": "YI-F5", "when": { "yi_pustules": true }, "outcome": "followup", "followup_days": 2, "actions": ["clean_skin"] },
    { "id": "YI-F6", "when": { "yi_diarrhoea": true }, "outcome": "followup", "followup_days": 2, "actions": ["breastfeed_more"] },
    { "id": "YI-F7", "when": { "yi_eye": true }, "outcome": "followup", "followup_days": 2, "actions": ["clean_eyes"] },
    { "id": "YI-F8", "when": { "yi_feeding_problem": true }, "outcome": "followup", "followup_days": 2, "actions": ["counsel_feeding"] },
    { "id": "YI-DEFAULT", "when": {}, "outcome": "routine", "actions": ["counsel_feeding", "counsel_danger_signs"] }
  ],
  "signs": {
    "not_feeding": { "code": "nf", "text_en": "Not feeding well" },
    "convulsions": { "code": "cv", "text_en": "Convulsions" },
    "movement": { "code": "mv", "text_en": "Moves only when stimulated, or not at all" },
    "fast_breathing": { "code": "fb", "text_en": "Fast breathing (60 or more per minute)" },
    "chest_indrawing": { "code": "ci", "text_en": "Severe chest indrawing" },
    "fever": { "code": "fv", "text_en": "Fever (37.5 °C or above)" },
    "hypothermia": { "code": "ht", "text_en": "Low body temperature (below 35.5 °C)" },
    "jaundice": { "code": "jd", "text_en": "Yellow palms or soles" },
    "early_jaundice": { "code": "ej", "text_en": "Yellow in the first day of life" },
    "dehydration": { "code": "dh", "text_en": "Diarrhoea with dehydration" },
    "many_pustules": { "code": "sp", "text_en": "Many skin pustules or a large boil" }
  },
  "actions": {
    "keep_warm": { "text_en": "Keep the baby warm, skin to skin with the mother." },
    "breastfeed_on_way": { "text_en": "Keep breastfeeding, also on the way." },
    "go_now": { "text_en": "Go to the facility now. Do not wait." },
    "go_today": { "text_en": "Go to the facility today." },
    "kangaroo": { "text_en": "Keep the baby skin to skin on the mother's chest day and night." },
    "cord_care": { "text_en": "Keep the cord clean and dry. Put nothing on it." },
    "counsel_feeding": { "text_en": "Breastfeed only, day and night, at least 8 times." },
    "counsel_danger_signs": { "text_en": "Explain the danger signs and to come at once if any appear." },
    "jaundice_watch": { "text_en": "Look at the palms and soles again tomorrow, in daylight. If they are yellow, go to the facility that day." },
    "clean_skin": { "text_en": "Wash the pus spots gently with soap and clean water, dry them, and come back if they spread." },
    "breastfeed_more": { "text_en": "Breastfeed more often and for longer. Give no other drinks or water." },
    "clean_eyes": { "text_en": "Wipe each eye from the inside out with a clean cloth and boiled, cooled water. Give eye ointment as the guideline allows; come back if it is worse." }
  },
  "destination": {
    "default": "nearest:health_centre",
    "by_danger_sign": {
      "convulsions": "nearest:hospital",
      "not_feeding": "nearest:hospital",
      "movement": "nearest:hospital",
      "hypothermia": "nearest:hospital",
      "early_jaundice": "nearest:hospital"
    }
  }
}
